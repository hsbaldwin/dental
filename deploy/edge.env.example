# Caddy(HTTPS 앞단) 설정 — 서버에서 deploy/edge.env 로 복사
# 운영 · 스테이징 도메인(DNS A 레코드가 이 서버를 가리켜야 인증서가 발급됨)
SITE_DOMAIN=wdental.example.com
STAGING_DOMAIN=staging.wdental.example.com
APP_PORT=3000
STAGING_PORT=3100
# 스테이징 접속 계정. 비밀번호 해시 만들기: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '비밀번호'
STAGING_USER=staging
STAGING_HASH=
# 관리 화면(/admin, /api/admin)에 들어올 수 있는 곳(병원 · 개발자 고정 IP, 공백으로 구분). 비우면 제한 없음
ADMIN_ALLOW_IPS=
