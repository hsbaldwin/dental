# 운영 설정 — 서버에서 deploy/production.env 로 복사해 채웁니다. 이 파일(값이 든 것)은 저장소에 올리지 마세요.
# Docker env 파일은 값 뒤에 주석을 달 수 없습니다. 설명은 늘 윗줄에.

NODE_ENV=production
PORT=3000
# Caddy(HTTPS) 뒤에서 실행: 실제 접속지(IP)가 접속기록에 남고, 로그인 쿠키가 HTTPS 전용이 됨
TRUST_PROXY=1
COOKIE_SECURE=1

# 첫 실행 때만 쓰는 관리자 비밀번호. 로그인해서 바꾼 뒤 이 줄은 비우세요(오픈 전 점검이 알려 줌)
ADMIN_PASSWORD=

# 직원 알림(새 예약 · 취소 · 운영 알림 · 배포 결과): Slack · 잔디 · 카카오워크 수신 웹훅
NOTIFY_WEBHOOK_URL=
# 환자 문자 중계 주소: {"to","text"}를 받아 문자 업체 API로 넘기는 곳(README '문자 · 알림 연동')
SMS_WEBHOOK_URL=
# 위 두 웹훅에 Authorization: Bearer 로 붙일 토큰(선택)
WEBHOOK_TOKEN=

# 백업 암호화 키(필수, 16자 이상). 만들기: openssl rand -base64 32
# 이 키를 잃으면 백업을 풀 수 없습니다 — 서버 밖(비밀번호 관리자)에도 반드시 보관
BACKUP_KEY=
# 외부 상태 감시가 X-Health-Token 헤더로 보내면 백업 · 문자 상태까지 보여 줌. 만들기: openssl rand -hex 16
HEALTH_TOKEN=

# IP당 시간당 온라인 예약 · 상담 요청 허용 횟수
RESERVE_LIMIT_PER_HOUR=10
INQUIRY_LIMIT_PER_HOUR=10
