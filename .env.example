# 서버 포트
PORT=3000
# SQLite 데이터 파일 위치 (백업 대상)
DB_FILE=./data/wdental.db
# 첫 실행 때 만들어지는 관리자(admin) 비밀번호. 비우면 임시 비밀번호를 만들어 서버 로그에 출력합니다.
ADMIN_PASSWORD=
# HTTPS 리버스 프록시(Nginx, Caddy, 클라우드 로드밸런서) 뒤에서 실행하면 1
TRUST_PROXY=1
# HTTPS로만 접속한다면 1 (로그인 쿠키에 Secure 지정)
COOKIE_SECURE=1
# 새 예약·취소를 직원에게 알릴 웹훅 주소 (Slack·잔디·카카오워크 등). {"text": "..."} 를 POST
NOTIFY_WEBHOOK_URL=
# 환자 문자 발송 중계 주소. {"to": "01012345678", "text": "..."} 를 POST
SMS_WEBHOOK_URL=
# 위 두 웹훅에 Authorization: Bearer 로 붙일 토큰 (선택)
WEBHOOK_TOKEN=
# IP당 시간당 온라인 예약 신청 허용 횟수
RESERVE_LIMIT_PER_HOUR=10
